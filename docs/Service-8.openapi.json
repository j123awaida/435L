                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/NotificationRecord"
                  },
                  "title": "Response By User Joseph Awaida Notifications User  User Id  Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
