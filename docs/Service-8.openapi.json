      "get": {
        "tags": [
          "Notifications"
        ],
        "summary": "Search notifications",
        "description": "Filter by user, type, severity and read status. Analysts are restricted to their own records; employees cannot search.",
        "operationId": "search_Joseph_Awaida_notifications_search_get",
        "security": [
          {
            "HTTPBearer": []
