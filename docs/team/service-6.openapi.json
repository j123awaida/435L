          },
          "failed_login_attempts": {
            "type": "integer",
            "title": "Failed Login Attempts"
          },
          "most_performed_actions": {
            "items": {
              "additionalProperties": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "type": "object"
            },
            "type": "array",
            "title": "Most Performed Actions"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/SourceStatus"
