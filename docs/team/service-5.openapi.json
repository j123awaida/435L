      "get": {
        "tags": [
          "Security Audit Logging"
        ],
        "summary": "Retrieve logs by user",
        "description": "Administrators and auditors retrieve every activity recorded for one user, newest first. A user with no recorded activity returns an empty array; an unknown user returns 404.",
        "operationId": "by_user_Mohammad_Nasrallah_logs_user__user_id__get",
        "security": [
